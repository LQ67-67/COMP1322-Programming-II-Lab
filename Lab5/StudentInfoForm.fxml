<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="StudentInfoForm">

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <GridPane hgap="10.0" vgap="10.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <!-- Row 0 -->
                <Label text="Student Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" maxWidth="1.7976931348623157E308"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"
                           GridPane.hgrow="ALWAYS"/>

                <!-- Row 1 -->
                <Label text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="idField" maxWidth="1.7976931348623157E308"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                           GridPane.hgrow="ALWAYS"/>

                <!-- Row 2 -->
                <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="deptComboBox" maxWidth="1.7976931348623157E308"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"
                          GridPane.hgrow="ALWAYS">
                    <items>
                        <FXCollections fx:factory="observableArrayList"
                                       xmlns:fx="http://javafx.com/fxml/1">
                            <String fx:value="CS"/>
                            <String fx:value="Math"/>
                            <String fx:value="Physics"/>
                            <String fx:value="Admin"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Row 3 -->
                <Label text="Year of Study:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <ChoiceBox fx:id="yearChoiceBox" maxWidth="1.7976931348623157E308"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"
                           GridPane.hgrow="ALWAYS">
                    <items>
                        <FXCollections fx:factory="observableArrayList"
                                       xmlns:fx="http://javafx.com/fxml/1">
                            <String fx:value="1"/>
                            <String fx:value="2"/>
                            <String fx:value="3"/>
                        </FXCollections>
                    </items>
                </ChoiceBox>
            </GridPane>

            <StackPane>
                <padding>
                    <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                </padding>
                <Button text="Submit"
                        maxWidth="1.7976931348623157E308"
                        onAction="#handleSubmit"/>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
